        function renderGameIdsSection() {
            const tagsEl = document.getElementById("id-filter-tags");
            tagsEl.innerHTML = SUGGESTED_ID_TAGS.map(t => `
                <button onclick="setSelectedIdTag('${t}')" class="px-3 py-1 rounded-full text-[11px] font-medium whitespace-nowrap border-2 transition-all ${selectedIdTag === t ? 'bg-theme-primaryDark text-white border-theme-primaryDark' : 'bg-theme-card text-theme-text border-theme-border'}">${t}</button>
            `).join("");

            const search = (document.getElementById("id-search-input")?.value || "").toLowerCase().trim();
            const minPrice = parseFloat(document.getElementById("filter-min-price")?.value) || 0;
            const maxPrice = parseFloat(document.getElementById("filter-max-price")?.value) || Infinity;

            const filtered = appData.gameIds.map((item, originalIdx) => ({ ...item, originalIdx })).filter(item => {
                const matchesTag = selectedIdTag === "ทั้งหมด" || (item.tags && item.tags.includes(selectedIdTag));
                const searchTarget = `${item.code} ${item.name} ${(item.tags||[]).join(' ')}`.toLowerCase();
                const matchesSearch = !search || searchTarget.includes(search);
                const priceNum = parseFloat(item.price) || 0;
                const matchesPrice = priceNum >= minPrice && priceNum <= maxPrice;
                return matchesTag && matchesSearch && matchesPrice;
            });

            document.getElementById("ids-count-badge").innerText = `${filtered.length} รายการ`;

            const list = document.getElementById("ids-grid-list");
            if (filtered.length === 0) {
                list.innerHTML = `<div class="col-span-full cute-card p-6 text-center text-xs text-theme-muted">ไม่พบไอดีเกมตามเงื่อนไข</div>`;
                return;
            }

            list.innerHTML = filtered.map(item => renderGameIdCardHTML(item, item.originalIdx)).join("");
        }

        function setSelectedIdTag(tag) {
            selectedIdTag = tag;
            renderGameIdsSection();
        }

