        function handleAlbumUpload(input, targetId) {
            const file = input.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = e => {
                const img = new Image();
                img.onload = () => {
                    const canvas = document.createElement("canvas");
                    const maxW = 750;
                    let w = img.width, h = img.height;
                    if (w > maxW) { h *= maxW / w; w = maxW; }
                    canvas.width = w; canvas.height = h;
                    canvas.getContext("2d").drawImage(img, 0, 0, w, h);
                    document.getElementById(targetId).value = canvas.toDataURL("image/jpeg", 0.82);
                    showToast("อัปโหลดรูปสำเร็จ");
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function handleAudioUpload(input) {
            const file = input.files[0];
            if (!file) return;
            if (file.size > 3.5 * 1024 * 1024) {
                showToast("ไฟล์เพลงใหญ่เกิน 3.5MB แนะนำให้ใช้ลิงก์ MP3 แทน");
                return;
            }
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById("adm-music-url").value = e.target.result;
                if (!document.getElementById("adm-music-title").value.trim()) {
                    document.getElementById("adm-music-title").value = file.name.replace(/\.[^/.]+$/, "");
                }
                showToast("โหลดไฟล์เพลงเรียบร้อย กดบันทึกด้านล่างได้เลย");
            };
            reader.readAsDataURL(file);
        }

