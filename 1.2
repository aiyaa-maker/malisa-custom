<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Care Official Store - หน้าร้านค้าออนไลน์มินิมอล</title>
    
    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#ffb6c1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="Care Store">
    <link rel="apple-touch-icon" href="https://placehold.co/192x192/ffb6c1/593C47?text=CS">
    <link id="pwa-manifest-link" rel="manifest" href="">
    
    <!-- Google Fonts: Prompt & Mitr -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Mitr:wght@300;400;500;600&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Prompt', 'sans-serif'],
                        display: ['Mitr', 'Prompt', 'sans-serif'],
                    },
                    colors: {
                        theme: {
                            bg: 'var(--bg-main)',
                            card: 'var(--bg-card)',
                            soft: 'var(--bg-soft)',
                            primary: 'var(--primary)',
                            primaryDark: 'var(--primary-dark)',
                            accent: 'var(--accent)',
                            pink: 'var(--pink-accent)',
                            lime: 'var(--lime-accent)',
                            text: 'var(--text-main)',
                            muted: 'var(--text-muted)',
                            border: 'var(--border-soft)',
                        }
                    },
                    boxShadow: {
                        'cute': '0 8px 30px -4px var(--shadow-color)',
                        'float': '0 10px 25px -5px var(--shadow-strong)',
                        'island': '0 12px 32px -4px rgba(22, 163, 74, 0.35)',
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --bg-main: #F2FBF5;
            --bg-card: #FFFFFF;
            --bg-soft: #E6F8ED;
            --primary: #86efac;          /* Soft green */
            --primary-dark: #16a34a;     /* Vibrant green */
            --accent: #b0e0e6;           /* Blue accent */
            --pink-accent: #ffb6c1;      /* Pink accent */
            --lime-accent: #fef08a;
            --text-main: #1e3a2f;
            --text-muted: #5c7c6e;
            --border-soft: #ffffff;      /* Heavy white borders */
            --shadow-color: rgba(22, 163, 74, 0.14);
            --shadow-strong: rgba(22, 163, 74, 0.28);
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            font-family: 'Prompt', sans-serif;
            -webkit-tap-highlight-color: transparent;
            overflow-x: hidden;
            /* 45-degree small dot background pattern */
            background-image: radial-gradient(circle, #86efac 1.2px, transparent 1.2px);
            background-size: 16px 16px;
            background-position: 0 0, 8px 8px;
        }

        .font-cute {
            font-family: 'Mitr', 'Prompt', sans-serif;
        }

        /* Pastel Checkered Gingham Pattern with Green/Pink/Blue accents */
        .banner-gingham {
            background-color: #ffffff;
            background-image:
                linear-gradient(90deg, rgba(134, 239, 172, 0.35) 50%, transparent 50%),
                linear-gradient(rgba(255, 182, 193, 0.35) 50%, transparent 50%);
            background-size: 28px 28px;
        }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg-main); }
        ::-webkit-scrollbar-thumb { background: var(--primary-dark); border-radius: 999px; }

        .fade-in { animation: fadeIn 0.28s cubic-bezier(0.16, 1, 0.3, 1); }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Heavy White Borders across all cards & components */
        .cute-card {
            background-color: var(--bg-card);
            border: 4px solid #ffffff;
            border-radius: 1.75rem;
            box-shadow: 0 8px 28px -4px var(--shadow-color);
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Bouncing Heart Loader Animation */
        @keyframes heartBounce {
            0%, 100% { transform: translateY(0) scale(1); }
            35% { transform: translateY(-22px) scale(1.12, 0.92); }
            65% { transform: translateY(2px) scale(0.94, 1.08); }
        }
        @keyframes shadowPulse {
            0%, 100% { transform: scale(1); opacity: 0.35; }
            35% { transform: scale(0.55); opacity: 0.12; }
        }
        .animate-heart-bounce { animation: heartBounce 0.95s infinite cubic-bezier(0.28, 0.84, 0.42, 1); }
        .animate-heart-shadow { animation: shadowPulse 0.95s infinite cubic-bezier(0.28, 0.84, 0.42, 1); }

        /* Vinyl Disc Rotation */
        @keyframes spinVinyl {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .vinyl-spinning { animation: spinVinyl 6s linear infinite; }
        .vinyl-paused { animation: spinVinyl 6s linear infinite; animation-play-state: paused; }
        .vinyl-grooves {
            background: repeating-radial-gradient(
                circle at center,
                #2a2024 0px,
                #2a2024 2px,
                #3c2e34 3px,
                #2a2024 4px
            );
        }
    </style>
</head>
<body class="min-h-screen pb-36">

    <!-- ==================== 1. BOUNCING HEART LOADER SCREEN ==================== -->
    <div id="heart-loader-overlay" class="fixed inset-0 z-[200] bg-theme-bg flex flex-col items-center justify-center transition-opacity duration-500" style="background-image: radial-gradient(var(--primary) 2px, transparent 2px); background-size: 24px 24px;">
        <div class="relative flex flex-col items-center">
            <div class="animate-heart-bounce drop-shadow-md">
                <svg class="w-20 h-20 text-theme-primaryDark" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
            </div>
            <div class="w-12 h-2.5 rounded-full bg-theme-primaryDark/40 mt-2 animate-heart-shadow"></div>
            <p class="font-cute text-sm font-medium text-theme-text mt-4 tracking-wide">กำลังเปิดร้าน Care Official Store...</p>
            <div class="flex gap-1.5 mt-2">
                <span class="w-2 h-2 rounded-full bg-theme-primary animate-bounce" style="animation-delay: 0s;"></span>
                <span class="w-2 h-2 rounded-full bg-theme-accent animate-bounce" style="animation-delay: 0.15s;"></span>
                <span class="w-2 h-2 rounded-full bg-theme-lime animate-bounce" style="animation-delay: 0.3s;"></span>
            </div>
        </div>
    </div>

    <!-- ==================== 2. FROSTED GLASS WHITE TRANSLUCENT WELCOME POP-UP ==================== -->
    <div id="welcome-popup-overlay" class="fixed inset-0 z-[180] hidden bg-theme-text/20 backdrop-blur-xs flex items-center justify-center p-4">
        <div class="w-full max-w-sm bg-white/85 backdrop-blur-xl rounded-[2rem] border-[3px] border-white shadow-2xl p-6 text-center space-y-4 fade-in relative overflow-hidden">
            <div class="w-14 h-14 mx-auto rounded-full bg-theme-soft border-[2.5px] border-theme-primary flex items-center justify-center text-theme-primaryDark shadow-xs">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            </div>
            <div class="space-y-2">
                <h2 id="welcome-popup-title" class="font-cute text-lg font-semibold text-theme-text">ยินดีต้อนรับสู่ Care Official Store</h2>
                <p id="welcome-popup-message" class="text-xs sm:text-sm text-theme-text/90 leading-relaxed whitespace-pre-line bg-white/70 p-3.5 rounded-2xl border-2 border-dotted border-theme-primary"></p>
            </div>
            <div class="pt-1">
                <button onclick="dismissWelcomeAndPlayMusic()" class="w-full py-3.5 px-6 rounded-full bg-theme-primaryDark hover:bg-theme-primary text-white font-cute font-medium text-sm shadow-float border-[3px] border-white transition-all active:scale-95 flex items-center justify-center gap-2">
                    <span>ถัดไป (เข้าสู่หน้าร้าน & เปิดเพลง)</span>
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Background Soft Gentle Audio Element -->
    <audio id="store-bg-audio" loop preload="auto"></audio>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-4 left-1/2 -translate-x-1/2 z-[190] flex flex-col items-center gap-2 pointer-events-none w-11/12 max-w-sm"></div>

        <!-- Main Responsive Container -->
        <div class="max-w-md md:max-w-3xl lg:max-w-5xl mx-auto min-h-screen bg-theme-bg/95 backdrop-blur-xs relative sm:border-x-4 sm:border-white shadow-cute transition-all">

        <!-- Top Controls Bar -->
        <div class="px-4 sm:px-6 pt-3.5 pb-1.5 z-30 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
                <button id="pwa-install-btn" onclick="installPWA()" class="flex items-center gap-1.5 text-xs font-medium text-theme-text bg-white hover:bg-theme-soft px-3.5 py-2 rounded-full transition-all shadow-xs border-4 border-white">
                    <svg class="w-3.5 h-3.5 text-theme-primaryDark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    <span>ติดตั้งแอพลงเครื่อง</span>
                </button>
            </div>
            <div class="flex items-center gap-2 ml-auto">
                <button onclick="openAdminModal()" class="flex items-center gap-1.5 px-3.5 h-9 rounded-full bg-white hover:bg-theme-soft text-theme-text text-xs font-medium shadow-xs border-4 border-white transition-all" title="ระบบหลังบ้านแอดมิน">
                    <svg class="w-3.5 h-3.5 text-theme-primaryDark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <span class="hidden sm:inline">แอดมิน</span>
                </button>
            </div>
        </div>

        <!-- ==================== VIEW: HOME (หน้าหลัก) ==================== -->
        <div id="view-home" class="view-section space-y-6 pb-24 fade-in">
            
            <!-- 1. Profile Card & Vinyl Music Player -->
            <section class="px-3 sm:px-6 pt-1">
                <div class="bg-theme-card rounded-[2rem] border-4 border-white shadow-cute overflow-hidden">
                    <!-- Cover Banner with Status Badge at Top-Right -->
                    <div class="w-full h-36 sm:h-48 banner-gingham relative border-b-4 border-white">
                        <img id="home-banner" src="" alt="Banner" class="w-full h-full object-cover cursor-pointer" onclick="openLightbox(this.src)" onerror="this.style.display='none'">
                        <!-- Status Badge (Green/Red glowing indicator) placed at Top-Right of banner -->
                        <div id="store-status-badge" class="absolute top-3 right-3 z-20 inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold border-4 border-white shadow-md transition-all">
                            <span id="store-status-dot" class="w-2.5 h-2.5 rounded-full"></span>
                            <span id="store-status-text">เปิดร้าน</span>
                        </div>
                    </div>
                    
                    <div class="px-4 sm:px-8 pb-6 -mt-12 sm:-mt-14 relative z-10">
                        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
                            <!-- Left/Center: Avatar & Name -->
                            <div class="flex flex-col items-center md:items-start text-center md:text-left">
                                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full p-1 bg-white shadow-md border-4 border-white relative">
                                    <img id="home-avatar" src="" alt="Profile" class="w-full h-full rounded-full object-cover cursor-pointer" onclick="openLightbox(this.src)" onerror="this.src='https://placehold.co/200x200/86efac/1e3a2f?text=CARE'">
                                    <span class="absolute bottom-0.5 right-0.5 w-6 h-6 rounded-full bg-theme-primaryDark text-white flex items-center justify-center text-[11px] font-bold border-2 border-white shadow-xs">✓</span>
                                </div>
                                
                                <div class="mt-3">
                                    <h1 id="home-store-name" class="font-cute text-lg sm:text-xl font-semibold text-theme-text">Care Official Store</h1>
                                </div>

                                <p id="home-store-desc" class="text-xs text-theme-muted mt-1 leading-relaxed whitespace-pre-line"></p>
                            </div>

                            <!-- Right: Relaxing Vinyl Record Music Player -->
                            <div class="bg-white/95 border-4 border-white rounded-3xl p-3 flex items-center gap-3 self-center md:self-end w-full max-w-xs shadow-sm">
                                <button onclick="toggleMusicPlay()" id="vinyl-disc-btn" class="relative w-14 h-14 rounded-full vinyl-grooves border-4 border-white flex items-center justify-center shrink-0 shadow-md cursor-pointer group vinyl-paused" title="กดเพื่อเล่น/หยุดเพลง">
                                    <div class="w-6 h-6 rounded-full bg-theme-primary border-2 border-white flex items-center justify-center">
                                        <div class="w-1.5 h-1.5 rounded-full bg-theme-text"></div>
                                    </div>
                                </button>
                                <div class="min-w-0 flex-1 text-left">
                                    <div class="flex items-center gap-1">
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full bg-theme-primary/40 text-theme-text">Soft BGM</span>
                                        <span id="music-status-label" class="text-[10px] text-theme-muted">หยุดชั่วคราว</span>
                                    </div>
                                    <p id="music-track-title" class="text-xs font-semibold text-theme-text truncate mt-1">Gentle Healing Lofi</p>
                                    <div class="flex items-center gap-2 mt-1">
                                        <button onclick="toggleMusicPlay()" id="music-play-text-btn" class="text-[11px] font-medium text-theme-primaryDark hover:underline">
                                            กดเปิดเพลง
                                        </button>
                                        <span class="text-theme-border">•</span>
                                        <button onclick="toggleMuteMusic()" id="music-mute-btn" class="text-[11px] text-theme-muted hover:text-theme-text">
                                            เสียงเปิดอยู่
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ข้อความรายละเอียดใต้โปรไฟล์แบบเด่น ๆ (แก้ไขได้ในหลังบ้าน) -->
                        <div class="mt-4 bg-gradient-to-r from-[#86efac]/30 via-[#ffb6c1]/25 to-[#b0e0e6]/30 p-3.5 sm:p-4 rounded-2xl border-4 border-white shadow-xs text-center">
                            <p id="home-highlight-promo" class="font-cute text-xs sm:text-sm font-medium text-theme-text leading-relaxed whitespace-pre-line"></p>
                        </div>

                        <!-- ปุ่มกด 3 ปุ่มใต้โปรไฟล์: ( ติดต่อสั่งซื้อ ) ( เครดิตไอดี ) ( เครดิตแอพพรี ) -->
                        <div class="mt-4 grid grid-cols-3 gap-2 sm:gap-3">
                            <a id="profile-btn-1" href="#" target="_blank" rel="noopener noreferrer" class="flex flex-col sm:flex-row items-center justify-center gap-1.5 py-2.5 px-2 sm:px-4 rounded-2xl bg-theme-primaryDark hover:bg-emerald-700 text-white font-cute font-medium text-xs shadow-float border-4 border-white transition-all active:scale-95 text-center">
                                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                                <span id="profile-btn-1-text" class="truncate">ติดต่อสั่งซื้อ</span>
                            </a>
                            <a id="profile-btn-2" href="#" target="_blank" rel="noopener noreferrer" class="flex flex-col sm:flex-row items-center justify-center gap-1.5 py-2.5 px-2 sm:px-4 rounded-2xl bg-[#b0e0e6] hover:bg-[#99d5dd] text-theme-text font-cute font-medium text-xs border-4 border-white transition-all active:scale-95 text-center">
                                <svg class="w-4 h-4 text-theme-primaryDark shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3z"/></svg>
                                <span id="profile-btn-2-text" class="truncate">เครดิตไอดี</span>
                            </a>
                            <a id="profile-btn-3" href="#" target="_blank" rel="noopener noreferrer" class="flex flex-col sm:flex-row items-center justify-center gap-1.5 py-2.5 px-2 sm:px-4 rounded-2xl bg-[#ffb6c1] hover:bg-[#f49fae] text-theme-text font-cute font-medium text-xs border-4 border-white transition-all active:scale-95 text-center">
                                <svg class="w-4 h-4 text-white shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                                <span id="profile-btn-3-text" class="truncate">เครดิตแอพพรี</span>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 2. Reviews Gallery (1:1 Aspect Ratio) -->
            <section class="px-4 sm:px-6 space-y-3">
                <div class="flex items-center justify-between px-1">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-5 rounded-full bg-theme-primaryDark"></span>
                        <h2 class="font-cute text-sm sm:text-base font-medium text-theme-text">รีวิวการขายจริง (1:1)</h2>
                    </div>
                    <button onclick="openAllReviewsModal()" class="text-xs font-medium text-theme-text bg-white hover:bg-theme-soft px-3.5 py-1 rounded-full transition-colors border-4 border-white shadow-xs">
                        ดูทั้งหมด (<span id="review-count-badge">0</span>)
                    </button>
                </div>
                <div class="relative">
                    <div id="home-reviews-carousel" class="flex gap-3.5 overflow-x-auto no-scrollbar pb-2 px-1 snap-x"></div>
                </div>
            </section>

            <!-- 3. Notice Box -->
            <section class="px-4 sm:px-6">
                <div class="bg-white/90 rounded-3xl p-4 border-4 border-white shadow-xs">
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-theme-soft text-theme-primaryDark border-2 border-white flex items-center justify-center shrink-0 mt-0.5 shadow-2xs">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
                        </div>
                        <p id="home-notice" class="text-xs sm:text-sm leading-relaxed text-theme-text font-normal whitespace-pre-line"></p>
                    </div>
                </div>
            </section>

            <!-- 4. Home Preview: Game IDs -->
            <section class="px-4 sm:px-6 space-y-3">
                <div class="flex items-center justify-between px-1">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-5 rounded-full bg-[#b0e0e6] border-2 border-[#7ec4ce]"></span>
                        <h2 class="font-cute text-sm sm:text-base font-medium text-theme-text">ไอดีเกมแนะนำ</h2>
                    </div>
                    <button onclick="switchTab('ids')" class="text-xs font-medium text-theme-primaryDark bg-theme-soft hover:bg-theme-primary/30 px-3.5 py-1 rounded-full transition-colors border-[3px] border-theme-border">
                        ดูทั้งหมด
                    </button>
                </div>
                <div id="home-ids-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5"></div>
            </section>

            <!-- 5. Home Preview: Premium Apps -->
            <section class="px-4 sm:px-6 space-y-3">
                <div class="flex items-center justify-between px-1">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-5 rounded-full bg-[#dde874] border-2 border-[#b9c746]"></span>
                        <h2 class="font-cute text-sm sm:text-base font-medium text-theme-text">แอพพรีเมียมยอดฮิต</h2>
                    </div>
                    <button onclick="switchTab('apps')" class="text-xs font-medium text-theme-primaryDark bg-theme-soft hover:bg-theme-primary/30 px-3.5 py-1 rounded-full transition-colors border-[3px] border-theme-border">
                        ดูทั้งหมด
                    </button>
                </div>
                <div id="home-apps-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5"></div>
            </section>

            <!-- 6. Showcase Section (หัวข้อ "ผลงาน" และแสดง "Coming soon ..." เมื่อยังไม่มีรายการ) -->
            <section class="px-4 sm:px-6 space-y-3">
                <div class="flex items-center justify-between px-1">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-5 rounded-full bg-theme-primaryDark"></span>
