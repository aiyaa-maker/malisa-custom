            };
            if (!b.bankTitle || !b.accountNumber) { showToast("กรุณากรอกชื่อธนาคารและเลขบัญชี"); return; }
            if (editIdx >= 0) appData.banks[editIdx] = b;
            else appData.banks.push(b);
            resetBankForm();
            saveAppData();
            showToast("บันทึกบัญชีสำเร็จ");
        }

        function editBankAccountItem(i) {
            const b = appData.banks[i];
            document.getElementById("adm-bank-edit-index").value = i;
            document.getElementById("adm-bank-title").value = b.bankTitle;
            document.getElementById("adm-bank-name").value = b.accountName;
            document.getElementById("adm-bank-number").value = b.accountNumber;
            document.getElementById("adm-bank-slip").value = b.slipNote;
        }

        function deleteBankAccountItem(i) {
            appData.banks.splice(i, 1);
            saveAppData();
        }

        function resetBankForm() {
            document.getElementById("adm-bank-edit-index").value = "-1";
            document.getElementById("adm-bank-title").value = "";
            document.getElementById("adm-bank-name").value = "";
            document.getElementById("adm-bank-number").value = "";
            document.getElementById("adm-bank-slip").value = "";
        }

        function renderAdminLists() {
            document.getElementById("adm-ids-list").innerHTML = appData.gameIds.map((item, i) => `
                <div class="cute-card p-3 flex items-center justify-between">
                    <div><p class="font-medium"><b>${item.code}</b> ${item.name}</p><p class="text-[11px] text-theme-muted">${item.price} ฿ | ${item.downPrice}</p></div>
                    <div class="flex gap-1"><button onclick="editGameIdItem(${i})" class="px-2.5 py-1 rounded-xl bg-theme-soft border border-theme-border">แก้ไข</button><button onclick="deleteGameIdItem(${i})" class="px-2.5 py-1 rounded-xl bg-rose-50 text-rose-500 border border-rose-200">ลบ</button></div>
                </div>
            `).join("");

            document.getElementById("adm-apps-list").innerHTML = appData.premiumApps.map((app, i) => `
                <div class="cute-card p-3 flex items-center justify-between">
                    <div><p class="font-medium">${app.name}</p></div>
                    <div class="flex gap-1"><button onclick="editPremiumAppItem(${i})" class="px-2.5 py-1 rounded-xl bg-theme-soft border border-theme-border">แก้ไข</button><button onclick="deletePremiumAppItem(${i})" class="px-2.5 py-1 rounded-xl bg-rose-50 text-rose-500 border border-rose-200">ลบ</button></div>
                </div>
            `).join("");

            document.getElementById("adm-showcase-list").innerHTML = (appData.showcaseItems || []).map((item, i) => `
                <div class="cute-card p-3 flex items-center justify-between">
                    <div><p class="font-medium">${item.title}</p><p class="text-[11px] text-theme-muted">${item.desc}</p></div>
                    <div class="flex gap-1"><button onclick="editShowcaseItem(${i})" class="px-2.5 py-1 rounded-xl bg-theme-soft border border-theme-border">แก้ไข</button><button onclick="deleteShowcaseItem(${i})" class="px-2.5 py-1 rounded-xl bg-rose-50 text-rose-500 border border-rose-200">ลบ</button></div>
                </div>
            `).join("");

            document.getElementById("adm-banks-list").innerHTML = (appData.banks || []).map((b, i) => `
                <div class="cute-card p-3 flex items-center justify-between">
                    <div><p class="font-medium">${b.bankTitle}</p><p class="text-[11px] text-theme-muted">${b.accountNumber} | โน้ต: ${b.slipNote || '-'}</p></div>
                    <div class="flex gap-1"><button onclick="editBankAccountItem(${i})" class="px-2.5 py-1 rounded-xl bg-theme-soft border border-theme-border">แก้ไข</button><button onclick="deleteBankAccountItem(${i})" class="px-2.5 py-1 rounded-xl bg-rose-50 text-rose-500 border border-rose-200">ลบ</button></div>
                </div>
            `).join("");

            document.getElementById("adm-reviews-list").innerHTML = appData.reviews.map((url, i) => `
                <div class="relative aspect-square rounded-2xl overflow-hidden border-2 border-theme-border">
                    <img src="${url}" class="w-full h-full object-cover cursor-pointer" onclick="openLightbox('${url}')">
                    <button onclick="deleteReviewItem(${i})" class="absolute top-1.5 right-1.5 bg-rose-500 text-white rounded-full px-2 py-0.5 text-[10px] shadow">ลบ</button>
                </div>
            `).join("");
        }

        window.onload = function() {
            applyThemeColors(appData.theme);
            switchTab('home');
            renderAll();
            initLoaderAndWelcome();
        };
    </script>
</body>
</html>
