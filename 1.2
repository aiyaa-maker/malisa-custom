        function loadAppData() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    return {
                        ...JSON.parse(JSON.stringify(DEFAULT_DATA)),
                        ...parsed,
                        store: { ...DEFAULT_DATA.store, ...(parsed.store || {}) }
                    };
                }
            } catch (e) {}
            return JSON.parse(JSON.stringify(DEFAULT_DATA));
        }

        function saveAppData() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(appData));
                applyThemeColors(appData.theme);
                renderAll();
            } catch (e) {
                showToast("พื้นที่เก็บข้อมูลเต็ม กรุณาลบบางรูปหรือใช้ลิงก์ URL");
            }
        }

        function resetAllStoreData() {
            localStorage.removeItem(STORAGE_KEY);
            appData = JSON.parse(JSON.stringify(DEFAULT_DATA));
            saveAppData();
            showAdminDashboard();
            showToast("รีเซ็ตเป็นค่าเริ่มต้นร้านแคร์เรียบร้อย!");
        }

        function applyThemeColors(t) {
            if (!t) return;
            const root = document.documentElement;
            root.style.setProperty("--bg-main", t.bgMain);
            root.style.setProperty("--bg-card", t.bgCard);
            root.style.setProperty("--bg-soft", t.bgSoft);
            root.style.setProperty("--primary", t.primary);
            root.style.setProperty("--primary-dark", t.primaryDark);
            root.style.setProperty("--accent", t.accent || "#b0e0e6");
            root.style.setProperty("--lime-accent", t.limeAccent || "#dde874");
            root.style.setProperty("--text-main", t.textMain);
            root.style.setProperty("--border-soft", t.borderSoft);
            root.style.setProperty("--shadow-color", hexToRgba(t.primaryDark, 0.14));
            root.style.setProperty("--shadow-strong", hexToRgba(t.primaryDark, 0.28));
        }

        function hexToRgba(hex, alpha) {
            const clean = hex.replace("#", "");
            if (clean.length !== 6) return `rgba(224, 122, 140, ${alpha})`;
            return `rgba(${parseInt(clean.substring(0,2),16)}, ${parseInt(clean.substring(2,4),16)}, ${parseInt(clean.substring(4,6),16)}, ${alpha})`;
        }

        function showToast(msg) {
            const container = document.getElementById("toast-container");
            const toast = document.createElement("div");
            toast.className = "bg-theme-text text-white text-xs font-medium px-4 py-2.5 rounded-full shadow-lg border-2 border-white flex items-center gap-2 fade-in";
            toast.innerHTML = `<span>${msg}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 2600);
        }

        function copyStringToClipboard(text, msg) {
            const temp = document.createElement("textarea");
            temp.value = text;
            document.body.appendChild(temp);
            temp.select();
            try {
                document.execCommand("copy");
                showToast(msg || "คัดลอกเรียบร้อย");
            } catch (e) {
                showToast("ไม่สามารถคัดลอกได้");
            }
            document.body.removeChild(temp);
        }

        function copyTextById(id, msg) {
            const el = document.getElementById(id);
            if (el) copyStringToClipboard(el.innerText.trim(), msg);
        }

        function triggerDownloadUrl(url, filename) {
            const link = document.createElement("a");
            link.href = url;
            link.download = filename || "QR.png";
            link.target = "_blank";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("กำลังบันทึกรูป...");
        }

        // ==================== LOADER, WELCOME POPUP & SOFT MUSIC ====================
        function initLoaderAndWelcome() {
            const s = appData.store;
            document.getElementById("welcome-popup-title").innerText = s.welcomeTitle || "ยินดีต้อนรับสู่ Care Official Store";
            document.getElementById("welcome-popup-message").innerText = s.welcomeMessage || "";
            
            const audioEl = document.getElementById("store-bg-audio");
            if (s.musicUrl) {
                audioEl.src = s.musicUrl;
            }

            setTimeout(() => {
                const loader = document.getElementById("heart-loader-overlay");
                loader.classList.add("opacity-0", "pointer-events-none");
                setTimeout(() => {
                    loader.classList.add("hidden");
                    document.getElementById("welcome-popup-overlay").classList.remove("hidden");
                }, 400);
            }, 1350);
        }

        function dismissWelcomeAndPlayMusic() {
            document.getElementById("welcome-popup-overlay").classList.add("hidden");
            playStoreMusic();
        }

        function playStoreMusic() {
            const audioEl = document.getElementById("store-bg-audio");
            if (!audioEl.src && appData.store.musicUrl) {
                audioEl.src = appData.store.musicUrl;
            }
            if (!audioEl.src) {
                showToast("ยังไม่ได้ตั้งค่าไฟล์เพลงในระบบหลังบ้าน");
                return;
            }
            audioEl.play().then(() => {
                isMusicPlaying = true;
                updateVinylUI();
            }).catch(() => {
                isMusicPlaying = false;
                updateVinylUI();
            });
        }

        function toggleMusicPlay() {
            const audioEl = document.getElementById("store-bg-audio");
            if (!audioEl.src && appData.store.musicUrl) {
                audioEl.src = appData.store.musicUrl;
            }
            if (isMusicPlaying) {
                audioEl.pause();
                isMusicPlaying = false;
            } else {
                audioEl.play().then(() => {
                    isMusicPlaying = true;
                    updateVinylUI();
                }).catch(() => {
                    showToast("ไม่สามารถเล่นเพลงได้ กรุณาตรวจสอบลิงก์เพลง");
                });
            }
            updateVinylUI();
        }

        function toggleMuteMusic() {
            const audioEl = document.getElementById("store-bg-audio");
            audioEl.muted = !audioEl.muted;
            document.getElementById("music-mute-btn").innerText = audioEl.muted ? "ปิดเสียงอยู่" : "เสียงเปิดอยู่";
        }

        function updateVinylUI() {
            const disc = document.getElementById("vinyl-disc-btn");
            const label = document.getElementById("music-status-label");
            const btnText = document.getElementById("music-play-text-btn");
            if (isMusicPlaying) {
                disc.classList.remove("vinyl-paused");
                disc.classList.add("vinyl-spinning");
                label.innerText = "กำลังเล่นเพลง ♪";
                label.className = "text-[10px] font-medium text-theme-primaryDark";
                btnText.innerText = "หยุดเพลง";
            } else {
                disc.classList.remove("vinyl-spinning");
                disc.classList.add("vinyl-paused");
                label.innerText = "หยุดชั่วคราว";
                label.className = "text-[10px] text-theme-muted";
                btnText.innerText = "กดเปิดเพลง";
            }
        }

        // ==================== NAVIGATION (หน้าหลัก | ไอดีเกม | แอพพรี | ชำระ) ====================
        function switchTab(tabName) {
            currentTab = tabName;
            ["home", "ids", "apps", "payment"].forEach(t => {
                const el = document.getElementById(`view-${t}`);
                if (el) el.classList.toggle("hidden", t !== tabName);

                const btn = document.getElementById(`nav-btn-${t}`);
                if (btn) {
                    if (t === tabName) {
                        btn.className = "flex flex-col items-center justify-center gap-0.5 py-1.5 px-2 rounded-full text-xs font-semibold bg-theme-primaryDark text-white shadow-xs transition-all";
                    } else {
                        btn.className = "flex flex-col items-center justify-center gap-0.5 py-1.5 px-2 rounded-full text-xs font-medium text-theme-muted hover:text-theme-primaryDark transition-all";
                    }
                }
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // ==================== PWA INSTALL PROMPT ====================
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
        });

        function installPWA() {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then((choiceResult) => {
                    if (choiceResult.outcome === 'accepted') showToast("ติดตั้งแอพสำเร็จแล้ว!");
                    deferredPrompt = null;
                });
            } else {
                document.getElementById("modal-ios-pwa").classList.remove("hidden");
            }
        }

